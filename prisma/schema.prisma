generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ==========================================================
 * ENUMS
 * ==========================================================
 */

enum Role {
  ADMIN
  MENTOR
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum StudentType {
  DAY_SCHOLAR
  HOSTELLER
}

enum AddressType {
  HOME
  HOSTEL
  RENTED
  OTHER
}

enum PreferredContactMethod {
  MOBILE
  EMAIL
  WHATSAPP
}

enum CommunicationEmailPreference {
  UNIVERSITY_EMAIL
  PERSONAL_EMAIL
}

/**
 * ==========================================================
 * USERS
 * ==========================================================
 */

model User {
  id String @id @default(cuid())

  fullName String

  username String @unique

  email String @unique

  password String

  role Role

  isActive Boolean @default(true)

  lastLogin DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?

  @@map("users")
}

/**
 * ==========================================================
 * STUDENT PROFILE
 * ==========================================================
 */

model StudentProfile {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  registerNumber String? @unique

  admissionNumber String? @unique

  profileImage String?

  dateOfBirth DateTime?

  gender Gender?

  bloodGroup BloodGroup?

  nationality String?

  religion String?

  department String?

  programme String?

  semester String?

  section String?

  studentType StudentType?

  address String? @db.Text

  permanentAddress String? @db.Text

  yearsAtUniversity String?

  totalCredits Int?

  currentCGPA Float?

  overallAttendance Float?

  academicStanding String?

  currentMentor String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  parentDetails StudentParentDetails?

  contactDetails StudentContactDetails?

  documents StudentDocument[]

  @@map("student_profiles")
}

/**
 * ==========================================================
 * STUDENT PARENT DETAILS
 * ==========================================================
 */

model StudentParentDetails {
  id String @id @default(cuid())

  studentProfileId String @unique

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  fatherName String?

  fatherOccupation String?

  fatherCompany String?

  fatherAnnualIncome String?

  fatherQualification String?

  fatherEmail String?

  fatherPhone String?

  fatherAddress String? @db.Text

  motherName String?

  motherOccupation String?

  motherQualification String?

  motherAnnualIncome String?

  motherEmail String?

  motherPhone String?

  motherAddress String? @db.Text

  guardianName String?

  guardianRelationship String?

  guardianPhone String?

  guardianAlternatePhone String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("student_parent_details")
}

/**
 * ==========================================================
 * STUDENT CONTACT DETAILS
 * ==========================================================
 */

model StudentContactDetails {
  id String @id @default(cuid())

  studentProfileId String @unique

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  permanentAddress String? @db.Text

  currentAddress String? @db.Text

  addressType AddressType?

  durationAtCurrentAddress String?

  personalMobile String?

  alternateMobile String?

  personalEmail String?

  alternateEmail String?

  whatsappNumber String?

  telegramUsername String?

  linkedInProfile String?

  githubProfile String?

  preferredContactMethod PreferredContactMethod?

  preferredContactTime String?

  communicationEmailPreference CommunicationEmailPreference?

  allowWhatsappCommunication Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("student_contact_details")
}

enum DocumentCategory {
  ACADEMICS
  CERTIFICATES
  INTERNSHIPS
  PROJECTS
  RESEARCH
  CO_CURRICULAR
  EXTRA_CURRICULAR
  AWARDS
  PERSONAL
  OTHER
}

model StudentDocument {
  id String @id @default(cuid())

  studentProfileId String

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  documentName String

  category DocumentCategory

  description String? @db.Text

  fileType String

  fileSize Int

  resourceType String

  cloudinaryPublicId String

  fileUrl String

  uploadedAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([studentProfileId])

  @@map("student_documents")
}